# Xcode project: generated from project.yml by XcodeGen. Never commit it.
Omramo.xcodeproj/
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build output
DerivedData/
build/
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/
*.xcresult
*.dSYM/
*.ipa
*.xcarchive

# SwiftPM: no remote dependencies, so there is nothing to pin.
Package.resolved

# Signing and other machine-local settings (never commit a team id or secrets)
Configuration/*.local.xcconfig
*.local.xcconfig
*.mobileprovision
*.p12
*.cer

# Python (tools/)
__pycache__/
*.pyc

# macOS, editors
.DS_Store
*.swp
*~
.idea/
.vscode/
