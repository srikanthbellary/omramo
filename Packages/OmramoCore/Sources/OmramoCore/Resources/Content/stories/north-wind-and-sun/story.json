        {
          "id": "s01-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The North Wind",
              "name": "north-wind"
            },
            {
              "t": " was boasting again. He was a great grey cloud with puffed-out cheeks."
            }
          ]
        },
        {
          "id": "s01-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“I am the strongest thing in the sky!”",
              "say": "north-wind",
              "chip": true
            },
            {
              "t": " he boomed. "
            },
            {
              "t": "“Stronger than rain. Stronger than thunder. Stronger than you!”",
              "say": "north-wind"
            }
          ]
        },
        {
          "id": "s01-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Sun",
              "name": "sun"
            },
            {
              "t": " smiled, and said nothing at all."
            }
          ]
        }
      ]
    },
