    "culture": {
      "lesson": "Fables are very short stories with a point. They were told in Greece about 2,500 years ago, people say by a storyteller named Aesop, and are still told everywhere.",
      "factCards": [
        "fable",
        "cloak",
        "colossus-moment"
      ]
    },
    "moral": {
      "lesson": "Gentleness wins where force fails: the Wind pushes and the traveller holds on; the Sun warms and the traveller chooses for himself.",
      "reflectionQuestion": "When has asking gently worked better for you than pushing?"
    }
  },
  "moral": "A gentle way often works better than force.",
