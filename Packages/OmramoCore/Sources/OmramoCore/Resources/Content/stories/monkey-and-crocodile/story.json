          "kind": "paragraph",
          "runs": [
            {
              "t": "“My son,”",
              "say": "mother-crocodile",
              "chip": true
            },
            {
              "t": " she said one day, "
            },
            {
              "t": "“I want a Monkey’s heart for my supper. Go and fetch me one.”",
              "say": "mother-crocodile"
            }
          ]
        }
      ]
    },
    {
