  "education": {
    "geography": {
      "lesson": "Nunavut lies in the far north of Canada: a land of tundra and sea ice with no trees, where the spring sun stays up late into the evening.",
      "factCards": [
        "nunavut",
        "hagia-sophia-moment"
      ]
    },
    "culture": {
      "lesson": "The snow house is Inuit engineering: a spiral of snow blocks that holds itself up, cut with a snow knife and lit by the stone lamp, the qulliq. Children learn it by watching an elder; families in Nunavut live in modern houses today and still teach this skill.",
      "factCards": [
        "snow-knife",
        "qulliq"
      ]
    },
    "moral": {
      "lesson": "Careful work, done patiently, holds together; every block leans on the others. Elisapie's rushed blocks crumble, and her slow ones become part of a house.",
      "reflectionQuestion": "When did going slowly help you make something that lasted?"
    }
  },
  "moral": "Careful, patient work holds together, because every block leans on the others.",
