          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The "
            },
            {
              "t": "old man",
              "name": "old-man"
            },
            {
              "t": " had a small friend, a brown "
            },
            {
              "t": "Sparrow",
              "name": "sparrow"
            },
            {
              "t": ". Every morning she hopped along the porch to meet him."
