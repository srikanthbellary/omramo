            },
            {
              "t": ". He took one bite. Then he put a few grains in his hand."
            }
          ]
        },
        {
          "id": "s02-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“One for me,”",
              "say": "old-man",
              "chip": true
            },
            {
              "t": " he said, "
            },
            {
              "t": "“and one for you, little friend.”",
