          ]
        },
        {
          "id": "s08-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "They brought him hot tea and rice cakes and sweet red beans. Then the young sparrows danced, flip, flap, flutter, and the old man laughed."
            }
          ]
        }
