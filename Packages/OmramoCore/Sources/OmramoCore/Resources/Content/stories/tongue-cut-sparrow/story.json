        },
        {
          "id": "s08-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“You are our ",
              "say": "sparrow",
              "chip": true
            },
            {
              "t": "guest",
              "say": "sparrow",
              "tap": "guest"
            },
            {
              "t": ",”",
              "say": "sparrow"
            },
            {
              "t": " said the Sparrow. "
            },
            {
              "t": "“Sit here, in the best place.”",
              "say": "sparrow"
