          "#FFE9B0",
          "#1C7FA6"
        ]
      },
      "blocks": [
        {
          "id": "s01-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Long ago in Egypt, a ",
              "lead": true
            },
            {
              "t": "Sailor",
              "lead": true,
              "name": "sailor"
            },
            {
              "t": " set out across the ",
              "lead": true
            },
            {
              "t": "Red Sea",
              "lead": true,
              "tap": "red-sea"
            },
            {
              "t": ".",
              "lead": true
            }
          ]
        },
        {
          "id": "s01-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "His ship was the biggest on the water. A hundred and twenty sailors rowed it, each one braver than a lion."
            }
          ]
        },
        {
          "id": "s01-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "They were going to the king’s mines, far, far away."
            }
          ]
        },
        {
          "id": "s01-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“The wind will be kind,”",
              "say": "captain",
              "chip": true
            },
            {
              "t": " said the "
            },
            {
              "t": "Captain",
              "name": "captain"
            },
            {
              "t": ". "
            },
            {
              "t": "“We will be home before the figs are ripe.”",
              "say": "captain"
            }
          ]
        }
      ]
    },
    {
      "id": "s02",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-ship.unfolded.heic",
          "alt": "A great wooden Egyptian ship with one wide square sail and rows of oars crosses a blue sea. Far off, low dark clouds are gathering.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-ship.folded.heic",
          "alt": "A great Egyptian ship with a wide square sail on a blue sea.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFEAF2",
          "#FFE9B0",
          "#1C7FA6"
        ]
      },
      "blocks": [
        {
          "id": "s02-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Up went the great square "
            },
            {
              "t": "sail",
              "tap": "opera-house-moment"
            },
            {
              "t": ". The wind filled it, round and white."
            }
          ]
        },
        {
          "id": "s02-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "For days the ship ran over the blue water, and the sailors sang."
            }
          ]
        },
        {
          "id": "s02-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Then the sky turned dark. The wind began to howl. Waves stood up as tall as houses."
            }
          ]
        },
        {
          "id": "s02-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Hold on!”",
              "say": "captain",
              "chip": true
            },
            {
              "t": " shouted the Captain. "
            },
            {
              "t": "“Hold on, my lions!”",
              "say": "captain"
            }
          ]
        }
      ]
    },
    {
      "id": "s03",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-ship.unfolded.heic",
          "alt": "A great wooden Egyptian ship with one wide square sail and rows of oars crosses a blue sea. Far off, low dark clouds are gathering.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-ship.folded.heic",
          "alt": "A great Egyptian ship with a wide square sail on a blue sea.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFEAF2",
          "#FFE9B0",
          "#1C7FA6"
        ]
      },
      "blocks": [
        {
          "id": "s03-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The ship went up, and the ship went down. Up, and down."
            }
          ]
        },
        {
          "id": "s03-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Then came the biggest wave of all. "
            },
            {
              "t": "Crash!",
              "fx": "pop",
              "scale": 1.3
            },
            {
              "t": " It swept the Sailor off the deck and into the sea."
            }
          ]
        },
        {
          "id": "s03-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "He caught hold of a plank of wood. All night long the dark water carried him."
            }
          ]
        }
      ]
    },
    {
      "id": "s04",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-island.unfolded.heic",
          "alt": "A sailor sits alone on the sandy shore of a green island, under fig trees heavy with fruit. The sea is empty.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-island.folded.heic",
          "alt": "A sailor sits alone under a fig tree on a sandy shore.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#C6EEE6",
          "#FFF0B8",
          "#2FA39A"
        ]
      },
      "blocks": [
        {
          "id": "s04-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "In the morning a wave set him down on warm sand. He was on an island."
            }
          ]
        },
        {
          "id": "s04-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "He looked for the great ship. He saw only water."
            }
          ]
        },
        {
          "id": "s04-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“I am all alone,”",
              "say": "sailor",
              "chip": true
            },
            {
              "t": " said the Sailor."
            }
          ]
        },
        {
          "id": "s04-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "For three days he lay in the shade of a fig tree, too sad to move."
            }
          ]
        }
      ]
    },
    {
      "id": "s05",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-island.unfolded.heic",
          "alt": "A sailor sits alone on the sandy shore of a green island, under fig trees heavy with fruit. The sea is empty.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-island.folded.heic",
          "alt": "A sailor sits alone under a fig tree on a sandy shore.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#C6EEE6",
          "#FFF0B8",
          "#2FA39A"
        ]
      },
      "blocks": [
        {
          "id": "s05-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Then he grew hungry. He stood up and looked around."
            }
          ]
        },
        {
          "id": "s05-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "What an island! There were figs and grapes, fat melons, fish in the pools and birds in every tree."
            }
          ]
        },
        {
          "id": "s05-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "He ate until he was full. Then he lit a little fire, to thank his gods."
            }
          ]
        },
        {
          "id": "s05-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "That was when the thunder began."
            }
          ]
        }
      ]
    },
    {
      "id": "s06",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-serpent.unfolded.heic",
          "alt": "A great golden serpent with blue eyebrows and a long beard bends its head kindly towards a small sailor, among the trees of the island.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-serpent.folded.heic",
          "alt": "A golden serpent with blue eyebrows looks kindly at a small sailor.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#D3EEDD",
          "#FFE6A6",
          "#3C9A6B"
        ]
      },
      "blocks": [
        {
          "id": "s06-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "But it was not thunder. The trees shook. The ground shook. The Sailor shook most of all."
            }
          ]
        },
        {
          "id": "s06-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "He hid his face in his hands. When he peeped out, a great "
            },
            {
              "t": "Serpent",
              "name": "serpent"
            },
            {
              "t": " was coming towards him."
            }
          ]
        },
        {
          "id": "s06-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "His scales shone like gold. His eyebrows were blue as the bluest stone. He wore a long beard, like a king’s."
            }
          ]
        }
      ]
    },
    {
      "id": "s07",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-serpent.unfolded.heic",
          "alt": "A great golden serpent with blue eyebrows and a long beard bends its head kindly towards a small sailor, among the trees of the island.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-serpent.folded.heic",
          "alt": "A golden serpent with blue eyebrows looks kindly at a small sailor.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#D3EEDD",
          "#FFE6A6",
          "#3C9A6B"
        ]
      },
      "blocks": [
        {
          "id": "s07-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Serpent rose up above him."
            }
          ]
        },
        {
          "id": "s07-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Who brought you here, little one?”",
              "say": "serpent",
              "chip": true
            },
            {
              "t": " he asked. "
            },
            {
              "t": "“Who brought you here? Who brought you to my island?”",
              "say": "serpent"
            }
          ]
        },
        {
          "id": "s07-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Sailor lay flat on the sand. He opened his mouth, but no words came out."
            }
          ]
        },
        {
          "id": "s07-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "So the Serpent picked him up in his mouth, as softly as a cat carries her kitten, and carried him away to his den."
            }
          ]
        }
      ]
    },
    {
      "id": "s08",
      "part": "part-2",
      "scene": {
        "unfolded": {
          "file": "art/scene-serpent.unfolded.heic",
          "alt": "A great golden serpent with blue eyebrows and a long beard bends its head kindly towards a small sailor, among the trees of the island.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-serpent.folded.heic",
          "alt": "A golden serpent with blue eyebrows looks kindly at a small sailor.",
