      },
      "blocks": [
        {
          "id": "s08-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Serpent set him down without a scratch.",
              "lead": true
            }
          ]
        },
        {
          "id": "s08-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Now, little one,”",
              "say": "serpent",
              "chip": true
            },
            {
              "t": " he said, "
            },
            {
              "t": "“who brought you here?”",
              "say": "serpent"
            }
          ]
        },
        {
          "id": "s08-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "So the Sailor told him about the ship, the storm and the great wave. "
