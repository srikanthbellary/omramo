      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-ship.unfolded.heic",
          "alt": "A great wooden Egyptian ship with one wide square sail and rows of oars crosses a blue sea. Far off, low dark clouds are gathering.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-ship.folded.heic",
          "alt": "A great Egyptian ship with a wide square sail on a blue sea.",
