          "#6FA85A"
        ]
      },
      "blocks": [
        {
          "id": "s02-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "In the dry golden hills of "
            },
            {
              "t": "Persia",
              "tap": "persia"
            },
            {
              "t": " lay a green valley."
            }
          ]
        },
        {
          "id": "s02-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "A cold stream ran through it. Deer drank there, and gazelles, and a fox, and a slow old tortoise, and one small hare."
            }
          ]
        },
        {
          "id": "s02-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "It would have been the best valley in the world, but for the "
            },
            {
              "t": "Lion",
              "name": "lion"
            },
            {
              "t": "."
            }
          ]
        }
      ]
    },
    {
      "id": "s03",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-valley.unfolded.heic",
          "alt": "A green valley with a stream between dry golden hills. Deer, gazelles, a fox, a tortoise and a hare are by the water. A lion stands on a rock above them.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-valley.folded.heic",
          "alt": "A lion stands on a rock above a green valley with a stream.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFEFEA",
          "#FFEFC0",
          "#6FA85A"
        ]
      },
      "blocks": [
        {
          "id": "s03-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Every day the Lion stood on his rock and roared."
            }
          ]
        },
        {
          "id": "s03-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Every day he chased the deer from the grass and the gazelles from the stream. He chased the fox. He even chased the tortoise, which was not hard."
            }
          ]
        },
        {
          "id": "s03-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Nobody could eat in peace. Nobody could drink in peace. Nobody could even nap."
            }
          ]
        }
      ]
    },
    {
      "id": "s04",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-council.unfolded.heic",
          "alt": "The animals of the valley sit together under a great plane tree in the evening. A little hare sits in the long grass, thinking.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-council.folded.heic",
          "alt": "A little hare sits thinking in the grass under a great plane tree.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#D9EEDD",
          "#FFE6AE",
          "#7FA650"
        ]
      },
      "blocks": [
        {
          "id": "s04-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "One evening the animals met under the great plane tree."
            }
          ]
        },
        {
          "id": "s04-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“I have not finished a meal since spring,”",
              "say": "tortoise",
              "chip": true
            },
            {
              "t": " said the "
            },
            {
              "t": "Tortoise",
              "name": "tortoise"
            },
            {
              "t": "."
            }
          ]
        },
        {
          "id": "s04-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“We cannot fight him,”",
              "say": "gazelle",
              "chip": true
            },
            {
              "t": " said the "
            },
            {
              "t": "Gazelle",
              "name": "gazelle"
            },
            {
              "t": ". "
            },
            {
              "t": "“We cannot outroar him. But perhaps we can make a bargain with him.”",
              "say": "gazelle"
            }
          ]
        },
        {
          "id": "s04-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "In the long grass sat the little "
            },
            {
              "t": "Hare",
              "name": "hare"
            },
            {
              "t": ". He said nothing. He only listened."
            }
          ]
        }
      ]
    },
    {
      "id": "s05",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-valley.unfolded.heic",
          "alt": "A green valley with a stream between dry golden hills. Deer, gazelles, a fox, a tortoise and a hare are by the water. A lion stands on a rock above them.",
