          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Then came the day it was the little Hare’s turn."
            }
          ]
        },
        {
          "id": "s07-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "But the Hare did not set off. He sat under the plane tree and twitched his "
            },
            {
              "t": "long ears",
              "tap": "wild-hare"
            },
            {
              "t": "."
            }
          ]
        },
        {
          "id": "s07-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Hurry, Hare!”",
              "say": "gazelle",
              "chip": true
            },
            {
              "t": " said the Gazelle. "
            },
            {
              "t": "“The sun is climbing. He will be so angry!”",
              "say": "gazelle"
            }
          ]
        },
        {
          "id": "s07-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Good,”",
              "say": "hare",
              "chip": true
            },
            {
              "t": " said the Hare. "
            },
            {
              "t": "“I have a plan, and it needs an angry lion. Give me a little time.”",
              "say": "hare"
            }
          ]
        }
      ]
