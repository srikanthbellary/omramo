      "blocks": [
        {
          "id": "s05-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "So they all went to the foot of the Lion’s rock."
            }
          ]
        },
        {
          "id": "s05-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Great Lion,”",
              "say": "gazelle",
              "chip": true
            },
            {
              "t": " said the Gazelle, "
            },
            {
              "t": "“stay in your den. Every day, one of us will bring your dinner to you.”",
              "say": "gazelle"
            }
          ]
        },
        {
          "id": "s05-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Lion yawned. He liked chasing. But he liked resting more."
            }
          ]
        },
        {
          "id": "s05-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Agreed,”",
              "say": "lion",
              "chip": true
            },
            {
              "t": " he said. "
            },
            {
              "t": "“But it must come every day. And it must never be late.”",
              "say": "lion"
            }
          ]
        }
      ]
    },
    {
      "id": "s06",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-valley.unfolded.heic",
          "alt": "A green valley with a stream between dry golden hills. Deer, gazelles, a fox, a tortoise and a hare are by the water. A lion stands on a rock above them.",
          "width": 2676,
          "height": 2160
