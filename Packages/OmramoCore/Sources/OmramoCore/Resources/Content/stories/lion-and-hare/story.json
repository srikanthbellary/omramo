          "id": "s01-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "This story walked from India to Persia with the ",
              "lead": true
            },
            {
              "t": "caravans",
              "lead": true,
              "tap": "petra-moment"
            },
            {
              "t": ".",
              "lead": true
            }
          ]
        },
        {
          "id": "s01-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "It rode on swaying camels, over mountains and across wide sands."
            }
          ]
        },
        {
          "id": "s01-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "At every well where the camels drank, somebody told it. Beside every fire, somebody told it again."
            }
          ]
        },
        {
          "id": "s01-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Now it has come all the way to you."
            }
          ]
        }
      ]
    },
    {
      "id": "s02",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-valley.unfolded.heic",
          "alt": "A green valley with a stream between dry golden hills. Deer, gazelles, a fox, a tortoise and a hare are by the water. A lion stands on a rock above them.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-valley.folded.heic",
          "alt": "A lion stands on a rock above a green valley with a stream.",
          "width": 1296,
          "height": 2160
