      "blocks": [
        {
          "id": "s04-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Dog wagged his tail, and on they went, two together."
            }
          ]
        },
        {
          "id": "s04-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Before long they met an old "
            },
            {
              "t": "Cat",
              "name": "cat"
            },
            {
              "t": " in the road, looking as gloomy as a week of rain."
            }
          ]
        },
        {
          "id": "s04-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“My teeth are blunt,”",
              "say": "cat",
              "chip": true
            },
            {
              "t": " she sighed. "
            },
            {
              "t": "“I would rather sit by the fire than chase mice. So nobody wants me.”",
              "say": "cat"
            }
          ]
        },
        {
          "id": "s04-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Come with us to Bremen. You have a fine voice!”",
              "say": "donkey",
              "chip": true
            }
          ]
        }
      ]
    },
    {
      "id": "s05",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-road.unfolded.heic",
          "alt": "A country road runs across flat green fields to a far-off town. A grey donkey walks along it past a wooden signpost, with a dog, a cat and a rooster.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-road.folded.heic",
          "alt": "A grey donkey walks along a country road past a wooden signpost.",
          "width": 1296,
