  "spreads": [
    {
      "id": "s01",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-road.unfolded.heic",
          "alt": "A country road runs across flat green fields to a far-off town. A grey donkey walks along it past a wooden signpost, with a dog, a cat and a rooster.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-road.folded.heic",
          "alt": "A grey donkey walks along a country road past a wooden signpost.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFE9F2",
          "#FFF1C4",
          "#8DB360"
        ]
      },
      "blocks": [
        {
          "id": "s01-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "An old ",
              "lead": true
            },
            {
              "t": "Donkey",
              "lead": true,
              "name": "donkey"
            },
            {
              "t": " had carried sacks to the ",
              "lead": true
            },
            {
              "t": "mill",
              "lead": true,
              "tap": "mill"
            },
            {
              "t": " for many years.",
              "lead": true
            }
          ]
        },
        {
          "id": "s01-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Now his legs were slow and his back was sore."
            }
          ]
        },
        {
          "id": "s01-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "One morning he heard his master grumble at the gate."
            }
          ]
        },
        {
          "id": "s01-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“That Donkey is too old to be useful,” the man said. “He is not worth his oats.”"
            }
          ]
        }
      ]
    },
    {
      "id": "s02",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-road.unfolded.heic",
          "alt": "A country road runs across flat green fields to a far-off town. A grey donkey walks along it past a wooden signpost, with a dog, a cat and a rooster.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-road.folded.heic",
          "alt": "A grey donkey walks along a country road past a wooden signpost.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFE9F2",
          "#FFF1C4",
          "#8DB360"
        ]
      },
      "blocks": [
        {
          "id": "s02-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "The Donkey’s long ears drooped. Then up they went again."
            }
          ]
        },
        {
          "id": "s02-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Too old?”",
              "say": "donkey",
              "chip": true
            },
            {
              "t": " he said. "
            },
            {
              "t": "“My legs are slow, but my voice is as loud as ever. Hee-haw!”",
              "say": "donkey"
            }
          ]
        },
        {
          "id": "s02-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“I know! I will go to ",
              "say": "donkey",
              "chip": true
            },
            {
              "t": "Bremen",
              "say": "donkey",
              "tap": "bremen-moment"
            },
            {
              "t": ", the great town by the river. They love music there.”",
              "say": "donkey"
            }
          ]
        },
        {
          "id": "s02-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "So he pushed open the gate and set off down the road."
            }
          ]
        }
      ]
    },
    {
      "id": "s03",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-road.unfolded.heic",
          "alt": "A country road runs across flat green fields to a far-off town. A grey donkey walks along it past a wooden signpost, with a dog, a cat and a rooster.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-road.folded.heic",
          "alt": "A grey donkey walks along a country road past a wooden signpost.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFE9F2",
          "#FFF1C4",
          "#8DB360"
        ]
      },
      "blocks": [
        {
          "id": "s03-b1",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "Soon he met an old "
            },
            {
              "t": "Dog",
              "name": "dog"
            },
            {
              "t": " lying by the road, puffing and panting."
            }
          ]
        },
        {
          "id": "s03-b2",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Why are you puffing so, friend?”",
              "say": "donkey",
              "chip": true
            },
            {
              "t": " asked the Donkey."
            }
          ]
        },
        {
          "id": "s03-b3",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“I cannot run fast any more,”",
              "say": "dog",
              "chip": true
            },
            {
              "t": " puffed the Dog. "
            },
            {
              "t": "“My master says I am no use. Where shall I go?”",
              "say": "dog"
            }
          ]
        },
        {
          "id": "s03-b4",
          "pane": "leading",
          "kind": "paragraph",
          "runs": [
            {
              "t": "“Come with me to Bremen. I am going to be a ",
              "say": "donkey",
              "chip": true
            },
            {
              "t": "town musician",
              "say": "donkey",
              "tap": "town-musician"
            },
            {
              "t": ". You have a fine voice!”",
              "say": "donkey"
            }
          ]
        }
      ]
    },
    {
      "id": "s04",
      "part": "part-1",
      "scene": {
        "unfolded": {
          "file": "art/scene-road.unfolded.heic",
          "alt": "A country road runs across flat green fields to a far-off town. A grey donkey walks along it past a wooden signpost, with a dog, a cat and a rooster.",
          "width": 2676,
          "height": 2160
        },
        "folded": {
          "file": "art/scene-road.folded.heic",
          "alt": "A grey donkey walks along a country road past a wooden signpost.",
          "width": 1296,
          "height": 2160
        },
        "fallbackColors": [
          "#CFE9F2",
