        "mill",
        "bremen-moment"
      ]
    },
    "culture": {
      "lesson": "The Grimm brothers wrote down tales that people told at home. Town musician was a real job: towns paid players for markets and festivals.",
      "factCards": [
        "town-musician",
        "timber-house"
      ]
    },
    "moral": {
      "lesson": "Nobody is too old to be useful; friends are stronger together. Four animals nobody wants make a home by using what each can still do.",
      "reflectionQuestion": "What can you and your friends do together that you could not do alone?"
    }
  },
  "moral": "You are never too old to be useful to your friends.",
